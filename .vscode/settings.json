{
  "i18n-ally.localesPaths": [
    "libs/**/i18n"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/tsconfig.json": true,
    "**/.gitignore": true,
    "**/.gitmodules": true,
    "**/.npmrc": true,
    "**/.nuxt": true,
    "**/.agents": true,
    "**/pnpm*": true,
    "**/eslint.config.mjs": true
  },
  "js/ts.preferences.importModuleSpecifier": "project-relative",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true
}
